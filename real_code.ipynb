    "print(\"\\nSTEP 8: MODEL EVALUATION...\")\n",
    "print(\"-\"*80)\n",
    "\n",
    "def sanitize_for_model(X):\n",
    "    datetime_cols = X.select_dtypes(include=['datetime64[ns]', 'datetime64']).columns.tolist()\n",
    "    if datetime_cols:\n",
    "        print(\"Dropping datetime columns BEFORE EVALUATION:\", datetime_cols)\n",
    "        X = X.drop(columns=datetime_cols)\n",
    "    return X\n",
    "\n",
    "X_test_num = sanitize_for_model(X_test)\n",
    "X_train_resampled_num = sanitize_for_model(X_train_resampled)\n",
    "\n",
    "results = {}  \n",
    "\n",
    "print(\"Models to evaluate:\", list(models.keys()))  # Debug info\n",
    "\n",
    "for model_name, model in models.items():\n",
    "    print(f\"\\n{'='*80}\")\n",
    "    print(f\"{model_name.upper()}\")\n",
    "    print(\"=\"*80)\n",
    "    try:\n",
    "        # Handle feature name mismatch robustly\n",
    "        ordered_cols = getattr(model, 'feature_names_in_', X_test_num.columns)\n",
    "        missing_cols = [col for col in ordered_cols if col not in X_test_num.columns]\n",
    "        if missing_cols:\n",
    "            print(f\"Skipping {model_name}: Columns missing from X_test_num: {missing_cols}\")\n",
    "            continue\n",
    "        X_test_num_curr = X_test_num[ordered_cols]\n",
    "\n",
    "        y_pred = model.predict(X_test_num_curr)\n",
    "        y_pred_proba = model.predict_proba(X_test_num_curr)[:, 1] if hasattr(model, 'predict_proba') else None\n",
    "        test_used = y_test\n",
    "\n",
    "        # For train set\n",
    "        missing_train_cols = [col for col in ordered_cols if col not in X_train_resampled_num.columns]\n",
    "        if missing_train_cols:\n",
    "            print(f\"Skipping train eval for {model_name}: Columns missing from X_train_resampled_num: {missing_train_cols}\")\n",
    "            y_train_pred_proba, train_used = None, None\n",
    "        else:\n",
    "            y_train_pred_proba = model.predict_proba(X_train_resampled_num[ordered_cols])[:, 1] if hasattr(model, 'predict_proba') else None\n",
    "            train_used = y_train_resampled\n",
    "\n",
    "        # Metrics\n",
    "        accuracy = accuracy_score(test_used, y_pred)\n",
    "        precision = precision_score(test_used, y_pred, zero_division=0)\n",
    "        recall = recall_score(test_used, y_pred, zero_division=0)\n",
    "        f1 = f1_score(test_used, y_pred, zero_division=0)\n",
    "        print(f\"Accuracy: {accuracy:.4f}\")\n",
    "        print(f\"Precision: {precision:.4f}\")\n",
    "        print(f\"Recall: {recall:.4f}\")\n",
    "        print(f\"F1-Score: {f1:.4f}\")\n",
    "\n",
    "        roc_auc = roc_auc_score(test_used, y_pred_proba) if y_pred_proba is not None else None\n",
    "        if roc_auc is not None:\n",
    "            print(f\"ROC-AUC: {roc_auc:.4f}\")\n",
    "\n",
    "        cm = confusion_matrix(test_used, y_pred)\n",
    "        print(f\"\\nConfusion Matrix:\")\n",
    "        print(f\" TN: {cm[0,0]:,} FP: {cm[0,1]:,}\")\n",
    "        print(f\" FN: {cm[1,0]:,} TP: {cm[1,1]:,}\")\n",
    "\n",
    "        # Store results\n",
    "        results[model_name] = {\n",
    "            'accuracy': accuracy,\n",
    "            'precision': precision,\n",
    "            'recall': recall,\n",
    "            'f1': f1,\n",
    "            'roc_auc': roc_auc,\n",
    "            'y_pred': y_pred,\n",
    "            'y_pred_proba': y_pred_proba,\n",
    "            'y_test': test_used,\n",
    "            'y_train_pred_proba': y_train_pred_proba,\n",
    "            'y_train': train_used\n",
    "        }\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"✗ Error for {model_name}: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()"
   ]
