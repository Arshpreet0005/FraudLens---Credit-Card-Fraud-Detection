    "\n",
    "def predict_fraud(new_data, model, scaler):\n",
    "    \"\"\"Predict fraud for new transactions\"\"\"\n",
    "    # Drop datetime columns to match training features\n",
    "    new_data_clean = new_data.select_dtypes(exclude=['datetime64[ns]', 'datetime64'])\n",
    "   \n",
    "\n",
    "    # Apply scaling only to numeric columns\n",
    "    numeric_features = new_data_clean.select_dtypes(include=['int64', 'float64']).columns\n",
    "    new_data_scaled = new_data_clean.copy()\n",
    "    new_data_scaled[numeric_features] = scaler.transform(new_data_clean[numeric_features])\n",
    "\n",
    "    predictions = model.predict(new_data_scaled)\n",
    "    probabilities = model.predict_proba(new_data_scaled)[:, 1] if hasattr(model, 'predict_proba') else None\n",
    "    return predictions, probabilities\n",
    "\n",
    "# Example prediction\n",
    "print(\"\\nExample: Predicting on a sample transaction...\")\n",
    "sample = X_test.iloc[0:1].copy()\n",
    "pred, prob = predict_fraud(sample, best_model, scaler)\n",
    "print(f\"Prediction: {'FRAUD ' if pred[0] == 1 else 'VALID '}\")\n",
    "if prob is not None:\n",
